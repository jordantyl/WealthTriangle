rules_version = '2';

// Draft rules based on every Firestore read/write path found in the Flutter
// client during this review. NOT deployed automatically — review and deploy
// yourself (Firebase Console > Firestore > Rules, or `firebase deploy
// --only firestore:rules` if this project has the Firebase CLI set up).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Per-user data: only the signed-in owner may read or write ----
    // `role` (admin flag, checked by the backend's _is_admin()) is excluded
    // from owner writes on purpose — otherwise any signed-in user could set
    // role: "admin" on their own doc via the client SDK and pass the
    // backend's admin check. Only the backend's Admin SDK (which bypasses
    // these rules) may set it, via POST /api/admin/users/<uid>/promote.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && !('role' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.get('role', null) == resource.data.get('role', null);
      allow delete: if request.auth != null && request.auth.uid == uid;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ---- Global app content (scenarios, quizzes, game items) ----
    // Read-only from the client. Writes are blocked here on purpose — the
    // Academy screen's "Update Database" button no longer writes to
    // Firestore directly; it calls a backend endpoint that uses the Firebase
    // Admin SDK (which bypasses these rules) to reseed instead. That way no
    // signed-in user, however friendly, can overwrite shared game content.
    match /academy_scenarios/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /academy_quizzes/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /academy_flash/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /academy_trade_items/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /academy_trade_events/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ---- Tycoon Battle (PvP) rooms ----
    // Read/list must stay open to any signed-in user: findRandomMatch()
    // queries across ALL rooms with status == 'waiting' to find one to join,
    // before the requester is a participant. Writes are restricted to the
    // two participants, and only after they're actually host or guest.
    match /tycoon_battles/{battleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostId == request.auth.uid;
      allow update: if request.auth != null
                    && (
                      // An existing participant (host or guest) may update
                      // freely — the app's own move-submission and
                      // round-advance logic writes several fields together
                      // in one call (host/guest cash+investments+locked,
                      // currentRound), and round-advance is already guarded
                      // client-side by a Firestore transaction that checks
                      // currentRound hasn't moved since it was read.
                      resource.data.hostId == request.auth.uid
                      || resource.data.guestId == request.auth.uid
                      // Joining an open room: guest slot must currently be
                      // empty, and — unlike the branches above — the write
                      // may ONLY touch the join fields. Previously this had
                      // no field restriction at all, so a joining guest's
                      // single `update()` call could rewrite ANY other
                      // field in the same document (the opponent's score,
                      // hostId, etc.) alongside legitimately claiming the
                      // guest slot.
                      || (resource.data.guestId == ""
                          && request.resource.data.guestId == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['guestId', 'guestName', 'status']))
                    );
      allow delete: if false;
    }
  }
}
