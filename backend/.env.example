# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored (see .gitignore) — it is loaded automatically
# by app.py via python-dotenv, so keys here persist across terminal
# restarts/reboots. Never commit the real backend/.env file.

# Required to protect every endpoint with a shared secret. Must match
# BACKEND_API_KEY in mobile_app/lib/.env exactly.
BACKEND_API_KEY=

# At least one of these two enables the AI Assistant (/api/assistant) and
# AI news summaries (/api/summarize). Gemini is free and preferred; get a
# key at https://aistudio.google.com/apikey (no card required).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Comma-separated Firebase UIDs allowed to call /api/admin/seed.
ADMIN_UIDS=

# Comma-separated web origins, only needed if you host a web build.
ALLOWED_ORIGINS=

# Optional — enables Sentry crash reporting. Get a DSN at https://sentry.io
SENTRY_DSN=
